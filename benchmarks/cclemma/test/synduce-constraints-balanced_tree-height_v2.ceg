(
  (data Bool (True False))
  (:: True Bool)
  (:: False Bool)
  (data Unit (Null))
  (:: Null Unit)
  (data Nat (Zero Succ))
  (:: Zero Nat)
  (:: Succ (-> (Nat) Nat))
  (data Tree (Nil Node))
  (:: Nil (-> (Unit) Tree))
  (:: Node (-> (Nat Tree Tree) Tree))
  (:: lq (-> (Nat Nat) Bool))
  (let lq (Zero (Succ ?x)) True)
  (let lq (?x Zero) False)
  (let lq ((Succ ?x) (Succ ?y)) (lq ?x ?y))
  (:: max (-> (Nat Nat) Nat))
  (let max (?tv0 ?tv1) (ite2 (lq ?tv0 ?tv1) ?tv1 ?tv0))
  (:: plus (-> (Nat Nat) Nat))
  (let plus (Zero ?x) ?x)
  (let plus ((Succ ?x) ?y) (Succ (plus ?x ?y)))
  (:: height1  (-> (Tree) Nat))
  (let height1  ((Nil ?tv5)) Zero)
  (let height1  ((Node ?tv6 ?tv7 ?tv8)) (plus (Succ Zero) (max (tf0 ?tv7) (tf0 ?tv8))))
  (:: tf0 (-> (Tree) Nat))
  (let tf0 (?tv3) (height1  ?tv3))
  (:: height (-> (Tree) Nat))
  (let height (?tv2) (tf0 ?tv2))
  (:: balanced1 (-> (Tree) Bool))
  (let balanced1 ((Nil ?tv12)) True)
  (let balanced1 ((Node ?tv13 ?tv14 ?tv15)) (and (and (nateq (height ?tv14) (height ?tv15)) (tf2 ?tv14)) (tf2 ?tv15)))
  (:: tf2 (-> (Tree) Bool))
  (let tf2 (?tv10) (balanced1 ?tv10))
  (:: balanced (-> (Tree) Bool))
  (let balanced (?tv9) (tf2 ?tv9))
  (:: nothing1 (-> (Tree) Tree))
  (let nothing1 ((Nil ?tv19)) (Nil Null))
  (let nothing1 ((Node ?tv20 ?tv21 ?tv22)) (Node ?tv20 (tf4 ?tv21) ?tv22))
  (:: tf4 (-> (Tree) Tree))
  (let tf4 (?tv17) (nothing1 ?tv17))
  (:: target (-> (Tree) Tree))
  (let target (?tv16) (tf4 ?tv16))
  (:: main (-> (Tree) Nat))
  (let main (?tv23) (ite2 (balanced ?tv23) (height (target ?tv23)) Zero))
  (:: weirdtargetNew (-> (Tree) Nat))
  (let weirdtargetNew ((Nil ?tv27)) Zero)
  (let weirdtargetNew ((Node ?tv28 ?tv29 ?tv30)) (plus (tf6 ?tv29) (max (tf6 ?tv29) (Succ Zero))))
  (:: tf6 (-> (Tree) Nat))
  (let tf6 (?tv25) (weirdtargetNew ?tv25))
  (:: targetNew (-> (Tree) Nat))
  (let targetNew (?tv24) (tf6 ?tv24))
  (:: mainNew (-> (Tree) Nat))
  (let mainNew (?tv31) (ite2 (balanced ?tv31) (targetNew ?tv31) Zero))

  (:: and (-> (Bool Bool) Bool))
  (let and (False ?x) False)
  (let and (?x False) False)
  (let and (True True) True)
  (:: or (-> (Bool Bool) Bool))
  (let or (True ?y) True)
  (let or (?x True) True)
  (let or (False False) False)
  (:: not (-> (Bool) Bool))
  (axiom not (True) False)
  (axiom not (False) True)
  (:: ite0 (-> (Bool Bool Bool) Bool))
  (axiom ite0 (True ?x ?y) ?x)
  (axiom ite0 (False ?x ?y) ?y)  
  (:: ite2 (-> (Bool Nat Nat) Nat))
  (axiom ite2 (True ?x ?y) ?x)
  (axiom ite2 (False ?x ?y) ?y)
  (:: nateq (-> (Nat Nat) Bool))
  (axiom nateq (Zero Zero) True)
  (axiom nateq (Zero (Succ ?x)) False)
  (axiom nateq ((Succ ?x) Zero) False)
  (axiom nateq ((Succ ?x) (Succ ?y)) (nateq ?x ?y))


  (=== optimize (inp0) (Tree) (main inp0) (mainNew inp0))
)
