(
  (data Bool (True False))
  (:: True Bool)
  (:: False Bool)
  (data Nat (Zero Succ))
  (:: Zero Nat)
  (:: Succ (-> (Nat) Nat))
  (data List (Elt Cons))
  (:: Elt (-> (Nat) List))
  (:: Cons (-> (Nat List) List))
  (data CList (Single Concat))
  (:: Single (-> (Nat) CList))
  (:: Concat (-> (CList CList) CList))
  (:: tf1 (-> (List List) List))
  (let tf1 (?tv5 (Elt ?tv6)) (Cons ?tv6 ?tv5))
  (let tf1 (?tv5 (Cons ?tv7 ?tv8)) (Cons ?tv7 (tf0 ?tv8 ?tv5)))
  (:: tf0 (-> (List List) List))
  (let tf0 (?tv2 ?tv3) (tf1 ?tv3 ?tv2))
  (:: cat (-> (List List) List))
  (let cat (?tv0 ?tv1) (tf0 ?tv0 ?tv1))
  (:: clistToList (-> (CList) List))
  (let clistToList ((Single ?tv12)) (Elt ?tv12))
  (let clistToList ((Concat ?tv13 ?tv14)) (cat (tf2 ?tv13) (tf2 ?tv14)))
  (:: tf2 (-> (CList) List))
  (let tf2 (?tv10) (clistToList ?tv10))
  (:: repr (-> (CList) List))
  (let repr (?tv9) (tf2 ?tv9))
  (:: max (-> (Nat Nat) Nat))
  (axiom max (?tv15 ?tv16) (ite2 (lq ?tv15 ?tv16) ?tv16 ?tv15))
  (:: clmax (-> (CList) Nat))
  (let clmax ((Single ?tv20)) ?tv20)
  (let clmax ((Concat ?tv21 ?tv22)) (max (tf4 ?tv21) (tf4 ?tv22)))
  (:: tf4 (-> (CList) Nat))
  (let tf4 (?tv18) (clmax ?tv18))
  (:: lmax (-> (CList) Nat))
  (axiom lmax (?tv17) (tf4 ?tv17))
  (:: min (-> (Nat Nat) Nat))
  (axiom min (?tv23 ?tv24) (ite2 (lq ?tv23 ?tv24) ?tv23 ?tv24))
  (:: clmin (-> (CList) Nat))
  (let clmin ((Single ?tv28)) ?tv28)
  (let clmin ((Concat ?tv29 ?tv30)) (min (tf6 ?tv29) (tf6 ?tv30)))
  (:: tf6 (-> (CList) Nat))
  (let tf6 (?tv26) (clmin ?tv26))
  (:: lmin (-> (CList) Nat))
  (axiom lmin (?tv25) (tf6 ?tv25))
  (:: tf9 (-> (CList) Bool))
  (let tf9 ((Single ?tv34)) True)
  (let tf9 ((Concat ?tv35 ?tv36)) (and (lq (lmax ?tv35) (lmin ?tv36)) (and (tf8 ?tv35) (tf8 ?tv36))))
  (:: tf8 (-> (CList) Bool))
  (let tf8 (?tv32) (tf9 ?tv32))
  (:: ispart (-> (CList) Bool))
  (let ispart (?tv31) (tf8 ?tv31))
  (:: listMax (-> (List) Nat))
  (let listMax ((Elt ?tv40)) ?tv40)
  (let listMax ((Cons ?tv41 ?tv42)) (max ?tv41 (tf10 ?tv42)))
  (:: tf10 (-> (List) Nat))
  (let tf10 (?tv38) (listMax ?tv38))
  (:: spec (-> (List) Nat))
  (let spec (?tv37) (tf10 ?tv37))
  (:: nothing2 (-> (CList CList) CList))
  (let nothing2 (?tv46 (Single ?tv47)) ?tv46)
  (let nothing2 (?tv46 (Concat ?tv48 ?tv49)) (Concat ?tv48 (nothing ?tv49)))
  (:: nothing (-> (CList) CList))
  (let nothing (?tv44) (nothing2 ?tv44 ?tv44))
  (:: target (-> (CList) CList))
  (let target (?tv43) (nothing ?tv43))
  (:: main (-> (CList) Nat))
  (let main (?tv50) (ite2 (ispart ?tv50) (spec (repr (target ?tv50))) Zero))
  (:: rightMost (-> (CList) Nat))
  (let rightMost ((Single ?tv54)) ?tv54)
  (let rightMost ((Concat ?tv55 ?tv56)) (tf14 ?tv56))
  (:: tf14 (-> (CList) Nat))
  (let tf14 (?tv52) (rightMost ?tv52))
  (:: targetNew (-> (CList) Nat))
  (let targetNew (?tv51) (tf14 ?tv51))
  (:: mainNew (-> (CList) Nat))
  (let mainNew (?tv57) (ite2 (ispart ?tv57) (targetNew ?tv57) Zero))

  (:: and (-> (Bool Bool) Bool))
  (let and (False ?x) False)
  (let and (?x False) False)
  (let and (True True) True)
  (:: or (-> (Bool Bool) Bool))
  (let or (True ?y) True)
  (let or (?x True) True)
  (let or (False False) False)
  (:: not (-> (Bool) Bool))
  (axiom not (True) False)
  (axiom not (False) True)
  (:: ite0 (-> (Bool Bool Bool) Bool))
  (axiom ite0 (True ?x ?y) ?x)
  (axiom ite0 (False ?x ?y) ?y)  
  (axiom ite0 (?x True True) True)
  (axiom ite0 (?x False False) False)  
  (:: ite2 (-> (Bool Nat Nat) Nat))
  (axiom ite2 (True ?x ?y) ?x)
  (axiom ite2 (False ?x ?y) ?y)
  (:: nateq (-> (Nat Nat) Bool))
  (axiom nateq (Zero Zero) True)
  (axiom nateq (Zero (Succ ?x)) False)
  (axiom nateq ((Succ ?x) Zero) False)
  (axiom nateq ((Succ ?x) (Succ ?y)) (nateq ?x ?y))
  (:: lq (-> (Nat Nat) Bool))
  (axiom lq (Zero (Succ ?x)) True)
  (axiom lq (?x Zero) False)
  (axiom lq ((Succ ?x) (Succ ?y)) (lq ?x ?y))
  
  (=== helper1 (inp0) (CList) (nothing2 inp0 inp0) inp0)

  (=== helper (inp0) (CList) (listMax (clistToList (nothing2 inp0 inp0))) (lmax inp0)
  (
    (=> (nothing2 ?a ?a) (?a))
    (<=> (max ?a (max (listMax ?b) (listMax ?c))) (max (max ?a (listMax ?b)) (listMax ?c)))
  ))
  (=== optimize (inp0) (CList) (main inp0) (mainNew inp0) 
  (
    (<=> (listMax (clistToList (nothing2 ?a ?a))) (lmax ?a))
  ))
)
